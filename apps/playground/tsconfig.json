{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `tsc` ne fait que VERIFIER (Vite construit) : sans `rootDir`, les
    // constats de balisage peuvent lire le contrat des composants genere pour
    // le serveur MCP (mcp-server/src/component-contract.generated.ts, #1009).
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
